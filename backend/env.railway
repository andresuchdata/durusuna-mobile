# =================================
# RAILWAY ENVIRONMENT VARIABLES
# =================================
# Copy these variables to your Railway project environment

# Application Settings
NODE_ENV=production
PORT=${{ railway.services.backend.port }}

# Database (Railway PostgreSQL Plugin)
DATABASE_URL=${{ railway.services.postgres.connectionString }}

# Redis (Railway Redis Plugin)
REDIS_URL=${{ railway.services.redis.connectionString }}

# JWT Secrets (Generate secure values)
JWT_SECRET=${{ railway.secrets.JWT_SECRET }}
JWT_REFRESH_SECRET=${{ railway.secrets.JWT_REFRESH_SECRET }}
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Cloud Storage (Cloudinary recommended for Railway)
CLOUDINARY_CLOUD_NAME=${{ railway.secrets.CLOUDINARY_CLOUD_NAME }}
CLOUDINARY_API_KEY=${{ railway.secrets.CLOUDINARY_API_KEY }}
CLOUDINARY_API_SECRET=${{ railway.secrets.CLOUDINARY_API_SECRET }}

# Email Configuration
SMTP_HOST=${{ railway.secrets.SMTP_HOST }}
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=${{ railway.secrets.SMTP_USER }}
SMTP_PASS=${{ railway.secrets.SMTP_PASS }}
SMTP_FROM=${{ railway.secrets.SMTP_FROM }}

# CORS (Use your frontend domain)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO
SOCKET_CORS_ORIGIN=*
SOCKET_TRANSPORTS=websocket,polling

# Security
SESSION_SECRET=${{ railway.secrets.SESSION_SECRET }}
BCRYPT_SALT_ROUNDS=12

# Feature Flags
ENABLE_FILE_UPLOADS=true
ENABLE_REAL_TIME_MESSAGING=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false

# Monitoring (Optional)
# SENTRY_DSN=${{ railway.secrets.SENTRY_DSN }} 